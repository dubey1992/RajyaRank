# ============================================================================
# RajyaRank — PRODUCTION environment. All secrets come from the secret manager;
# never commit real values. Razorpay LIVE keys only here.
# ============================================================================
NODE_ENV=production
APP_ENV=production

# --- Public URLs (apex + subdomains) ---
API_PUBLIC_URL=https://api.rajyarank.com
WEB_PUBLIC_URL=https://rajyarank.com
ADMIN_PUBLIC_URL=https://admin.rajyarank.com
NEXT_PUBLIC_API_URL=https://api.rajyarank.com
# apps/web's own copy of WEB_PUBLIC_URL, NEXT_PUBLIC_-prefixed so it's build-
# time inlined — see the comment in .env.example. Must actually be set on the
# Amplify app (not just here); WEB_PUBLIC_URL above stays as-is for apps/api.
NEXT_PUBLIC_SITE_URL=https://rajyarank.com
# Not a secret (client-exposed by definition) — real value shown like the
# URLs above. Must be set in the Amplify app's build-time env vars, not just
# here — see the NEXT_PUBLIC_GA_MEASUREMENT_ID comment in .env.example.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-P6M6BWKNWK

# --- Data (managed HA Postgres + Redis; TLS enforced; automated backups) ---
DATABASE_URL=postgresql://USER:PASS@db.prod.internal:5432/rajyarank?schema=public&sslmode=require
REDIS_URL=rediss://db.prod.internal:6379

# --- Auth / cookies ---
JWT_ACCESS_SECRET=__secret_manager__
JWT_REFRESH_SECRET=__secret_manager__
FIELD_ENCRYPTION_KEY=__kms_managed__
COOKIE_DOMAIN=.rajyarank.com
COOKIE_SECURE=true

# --- Providers (LIVE) ---
SMS_PROVIDER=msg91
SMS_API_KEY=__secret_manager__
SMTP_HOST=smtp.provider.com
SMTP_PORT=587
EMAIL_FROM="RajyaRank <no-reply@rajyarank.com>"
GOOGLE_CLIENT_ID=__secret_manager__
GOOGLE_CLIENT_SECRET=__secret_manager__
GOOGLE_CALLBACK_URL=https://api.rajyarank.com/api/v1/auth/student/google/callback
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
S3_REGION=ap-south-1
S3_ACCESS_KEY=__secret_manager__
S3_SECRET_KEY=__secret_manager__
S3_BUCKET_PRIVATE=rajyarank-prod-private
RAZORPAY_KEY_ID=rzp_live___secret_manager__
RAZORPAY_KEY_SECRET=__secret_manager__
RAZORPAY_WEBHOOK_SECRET=__secret_manager__

LOG_LEVEL=info
DEFAULT_LOCALE=hi
